# SPDX-License-Identifier: GPL-2.0-or-later
config board 'board'
	option enabled '1'
	option device 'lan0'
	option vid '500'
	option locale 'IT'             # FXS country profile; also accepts ETSI
	option playout_clock 'timer'

# Enable after provisioning a SIP account. No registration is attempted by default.
config account 'acc1'
	option enabled '0'
	option user ''
	option domain ''
	list codec 'PCMA'

config line 'line0'
	option port '0'
	option account 'acc1'

config line 'line1'
	option port '1'
	option account 'acc1'
