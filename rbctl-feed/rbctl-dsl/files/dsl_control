#!/bin/sh /etc/rc.common
#
# dsl_control — procd init script for rbctl-dsl.
#
# The daemon reads all line configuration from UCI (network.dsl +
# network.atm).  This script only passes the management interface and
# the hotplug notify-script path, then lets procd manage respawning.
#
# Install as /etc/init.d/dsl_control

START=97
USE_PROCD=1

PROG=/usr/sbin/rbctl-dsl
NOTIFY=/sbin/dsl_notify.sh

service_triggers() {
	procd_add_reload_trigger network
}

start_service() {
	local config_iface

	config_load network
	config_get config_iface dsl config_iface "lan0.500"

	procd_open_instance
	procd_set_param command "$PROG" \
		daemon \
		-i "$config_iface" \
		-n "$NOTIFY"
	procd_set_param respawn
	procd_set_param term_timeout 10
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	# Synthesize a final DOWN event so LEDs turn off and PPPoA stops.
	DSL_NOTIFICATION_TYPE="DSL_INTERFACE_STATUS" \
	DSL_INTERFACE_STATUS="DOWN" \
		"$NOTIFY" 2>/dev/null
}
